# Required to start the server
DATABASE_PASSWORD=your_password_here

# Meta WhatsApp webhook verification token (must match Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=orderwhatsapp_verify

# Shared WhatsApp Graph API access token (same for all whatsapp_settings rows)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
